# SQL Server
MSSQL_SA_PASSWORD=YourStrongPasswordHere123!
MSSQL_DATABASE=LibraryManagementDb

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Host ports
API_PORT=8080
WEB_PORT=4200
DB_PORT=1433

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT settings
JWT_ISSUER=LibraryManagement
JWT_AUDIENCE=LibraryManagement.Client
JWT_KEY=ChangeThisToAtLeast32Characters
JWT_EXPIRY_MINUTES=60

# Development seed users
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=ChangeThisUserPassword123!
